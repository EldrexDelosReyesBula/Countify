{
  "name": "Countify+",
  "short_name": "Countify+",
  "description": "Advanced writing analytics tool with real-time word count, character count, reading time, and more. Powered by LanDecs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#7c3aed",
  "background_color": "#FFFFFF",
  "categories": ["productivity", "writing", "tools"],
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    {
      "src": "/logo/countify.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/logo/countify.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/logo/countify.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/illustrations/DESKTOP_INSTALL.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Countify+ Desktop Interface"
    },
    {
      "src": "/assets/illustrations/MOBILE%20INSTALL.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Countify+ Mobile Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "New Activity",
      "short_name": "New",
      "description": "Create a new writing activity",
      "url": "/?new=true",
      "icons": [
        {
          "src": "/logo/countify_activity.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Stats",
      "description": "View your writing statistics",
      "url": "/?dashboard=true",
      "icons": [
        {
          "src": "/logo/countify_dashboard.svg",
          "sizes": "96x96",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt", ".text"],
        "text/markdown": [".md", ".markdown"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+countify",
      "url": "/?source=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "display_override": ["window-controls-overlay"],
  "handle_links": "preferred",
  "prefer_related_applications": false
}